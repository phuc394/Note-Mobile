<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Note invitation</title>
  </head>
  <body style="margin:0;background:#f4f7fb;font-family:Arial,Helvetica,sans-serif;color:#152033;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#f4f7fb;padding:28px 12px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:560px;background:#ffffff;border-radius:8px;overflow:hidden;border:1px solid #dbe3ef;">
            <tr>
              <td style="background:#2563eb;color:#ffffff;padding:22px 28px;">
                <h1 style="margin:0;font-size:22px;line-height:1.3;">You have been invited to a note</h1>
              </td>
            </tr>
            <tr>
              <td style="padding:28px;">
                <p style="margin:0 0 14px;font-size:16px;line-height:1.6;">{{inviterName}} invited you to access this note:</p>
                <p style="margin:0 0 18px;font-size:18px;line-height:1.5;font-weight:700;color:#0f172a;">{{noteTitle}}</p>
                <p style="margin:0 0 24px;font-size:15px;line-height:1.6;color:#475569;">Your permission: {{permission}}.</p>
                <a href="{{inviteUrl}}" style="display:inline-block;background:#2563eb;color:#ffffff;text-decoration:none;font-size:16px;font-weight:700;padding:13px 20px;border-radius:6px;">Open note</a>
                <p style="margin:24px 0 0;font-size:13px;line-height:1.6;color:#64748b;">If the button does not work, open this link: <a href="{{inviteUrl}}" style="color:#2563eb;">{{inviteUrl}}</a></p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
